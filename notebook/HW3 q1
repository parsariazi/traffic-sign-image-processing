   "source": [
    "# Get input and output paths from user\n",
    "input_image_path = input(\"Enter the path to the input image: \").strip().strip('\"')\n",
    "output_directory = input(\"Enter the output directory path: \").strip().strip('\"')\n",
    "\n",
    "# Read the input image\n",
    "original_image = cv2.imread(input_image_path)\n",
    "if original_image is None:\n",
    "    raise ValueError(f\"Cannot read image from '{input_image_path}'.\")\n",
    "\n",
    "# Get image dimensions\n",
    "image_height, image_width = original_image.shape[:2]\n",
    "\n",
    "# Preprocess the image for contour detection\n",
    "gray_image = cv2.cvtColor(original_image, cv2.COLOR_BGR2GRAY)\n",
    "blurred_image = cv2.GaussianBlur(gray_image, (5, 5), 0)\n",
    "edges = cv2.Canny(blurred_image, 50, 150)\n",
    "\n",
    "# Find contours in the edged image\n",
    "contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "\n",
    "classified_signs = {}\n",
    "\n",
    "# Process each contour (potential sign region)\n",
    "for contour in contours:\n",
    "    contour_area = cv2.contourArea(contour)\n",
    "    if contour_area < 1000:  \n",
    "        continue\n",
    "    \n",
    "    # Get bounding box coordinates\n",
    "    x_coord, y_coord, box_width, box_height = cv2.boundingRect(contour)\n",
    "    \n",
    "    # Skip invalid bounding boxes\n",
    "    if (x_coord < 0 or y_coord < 0 or \n",
    "        x_coord + box_width > image_width or \n",
    "        y_coord + box_height > image_height):\n",
    "        continue\n",
    "\n",
    "    # Extract the region of interest\n",
    "    roi = original_image[y_coord:y_coord+box_height, x_coord:x_coord+box_width]\n",
    "    if roi is None or roi.size == 0:\n",
    "        continue\n",
    "\n",
    "    # Classify the sign type for this region\n",
    "    try:\n",
    "        roi_height, roi_width = roi.shape[:2]\n",
    "        if roi_height < 50 or roi_width < 50:\n",
    "            sign_type = \"Unknown\"\n",
    "        else:\n",
    "            # Convert to HSV for color detection\n",
    "            hsv_roi = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)\n",
    "            \n",
    "            # Define color ranges for red (two ranges for red in HSV)\n",
    "            red_lower1 = np.array([0, 50, 50])\n",
    "            red_upper1 = np.array([10, 255, 255])\n",
    "            red_lower2 = np.array([160, 50, 50])\n",
    "            red_upper2 = np.array([180, 255, 255])\n",
    "            \n",
    "            # Create masks for red and blue colors\n",
    "            red_mask1 = cv2.inRange(hsv_roi, red_lower1, red_upper1)\n",
    "            red_mask2 = cv2.inRange(hsv_roi, red_lower2, red_upper2)\n",
    "            red_mask = cv2.bitwise_or(red_mask1, red_mask2)\n",
    "            \n",
    "            blue_lower = np.array([100, 100, 50])\n",
    "            blue_upper = np.array([130, 255, 255])\n",
    "            blue_mask = cv2.inRange(hsv_roi, blue_lower, blue_upper)\n",
    "            \n",
    "            # Calculate color ratios\n",
    "            red_ratio = cv2.countNonZero(red_mask) / (roi_height * roi_width)\n",
    "            blue_ratio = cv2.countNonZero(blue_mask) / (roi_height * roi_width)\n",
    "            \n",
    "            # Shape analysis using contours\n",
    "            gray_roi = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)\n",
    "            blurred_roi = cv2.GaussianBlur(gray_roi, (5, 5), 0)\n",
    "            roi_edges = cv2.Canny(blurred_roi, 50, 150)\n",
    "            roi_contours, _ = cv2.findContours(roi_edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "            \n",
    "            sign_type = \"Unknown\"\n",
    "            for roi_contour in roi_contours:\n",
    "                roi_contour_area = cv2.contourArea(roi_contour)\n",
    "                if roi_contour_area < 300:\n",
    "                    continue\n",
    "                \n",
    "                # Approximate the contour to determine shape\n",
    "                epsilon = 0.04 * cv2.arcLength(roi_contour, True)\n",
    "                approx = cv2.approxPolyDP(roi_contour, epsilon, True)\n",
    "                num_sides = len(approx)\n",
    "                \n",
    "                # Classify based on shape and color\n",
    "                if num_sides == 3 and red_ratio > 0.2 or num_sides >= 8 or (red_ratio > 0.1 and num_sides != 3 and num_sides != 5):\n",
    "                    sign_type = \"Warningyu\"\n",
    "                    break\n",
    "                elif num_sides == 5:\n",
    "                    sign_type = \"Directional\"\n",
    "                    break\n",
    "                elif :\n",
    "                    sign_type = \"Prohibitory\"\n",
    "                    break\n",
    "                elif num_sides == 4 and blue_ratio > 0.05:\n",
    "                    sign_type = \"Informative\"\n",
    "                    break\n",
    "                    \n",
    "    except Exception as error:\n",
    "        print(f\"Error processing sign at ({x_coord},{y_coord}): {error}\")\n",
    "        sign_type = \"Unknown\"\n",
    "\n",
    "    # Add the detected sign to the appropriate category\n",
    "    if sign_type not in classified_signs:\n",
    "        classified_signs[sign_type] = np.full_like(original_image, fill_value=255)  # White background\n",
    "    \n",
    "    classified_signs[sign_type][y_coord:y_coord+box_height, x_coord:x_coord+box_width] = roi\n",
    "\n",
    "# Save results\n",
    "os.makedirs(output_directory, exist_ok=True)\n",
    "for sign_type, output_image in classified_signs.items():\n",
    "    filename = os.path.join(output_directory, f\"{sign_type}.jpg\")\n",
    "    cv2.imwrite(filename, output_image)\n",
    "    print(f\"Saved '{sign_type}' sign image to {filename}\")\n",
    "\n",
    "print(\"Processing complete!\")"
   ]
  }
