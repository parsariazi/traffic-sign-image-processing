     "output_type": "stream",
     "text": [
      "Sign type: Direction guide\n"
     ]
    }
   ],
   "source": [
    "# Ask user for the file path and strip whitespace AND quotation marks\n",
    "input_path = input(\"Enter the image path: \").strip().strip('\"')\n",
    "\n",
    "# Loading image\n",
    "if not os.path.exists(input_path):\n",
    "    raise FileNotFoundError(f\"Image not found: {input_path}\")\n",
    "\n",
    "with open(input_path, \"rb\") as f:  \n",
    "    raw_data = np.frombuffer(f.read(), np.uint8) \n",
    "\n",
    "# Decode image\n",
    "decoded_img = cv2.imdecode(raw_data, cv2.IMREAD_COLOR)\n",
    "if decoded_img is None:\n",
    "    raise ValueError(f\"Failed to load image: {input_path}\")\n",
    " \n",
    "# Preprocessing \n",
    "target_dims = (400, 400)\n",
    "total_pixels = target_dims[0] * target_dims[1]\n",
    "resized_img = cv2.resize(decoded_img, target_dims)\n",
    "hsv_img = cv2.cvtColor(resized_img, cv2.COLOR_BGR2HSV)\n",
    "\n",
    "# Color masks\n",
    "low_red = cv2.inRange(hsv_img, (0, 50, 50), (10, 255, 255))\n",
    "high_red = cv2.inRange(hsv_img, (160, 50, 50), (180, 255, 255))\n",
    "full_red = cv2.bitwise_or(low_red, high_red)\n",
    "red_coverage = cv2.countNonZero(full_red) / total_pixels\n",
    "\n",
    "blue_mask = cv2.inRange(hsv_img, (100, 100, 50), (130, 255, 255))\n",
    "blue_coverage = cv2.countNonZero(blue_mask) / total_pixels\n",
    "\n",
    "# Shape detection\n",
    "gray_img = cv2.cvtColor(resized_img, cv2.COLOR_BGR2GRAY)\n",
    "blurred_img = cv2.GaussianBlur(gray_img, (5, 5), 0)\n",
    "edges = cv2.Canny(blurred_img, 50, 150)\n",
    "contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "\n",
    "primary_shape = None\n",
    "tri_contours, rect_contours = [], []\n",
    "is_direction_guide = False \n",
    "\n",
    "for cnt in contours:\n",
    "    if cv2.contourArea(cnt) < 1000:\n",
    "        continue\n",
    "\n",
    "    poly_approx = cv2.approxPolyDP(cnt, 0.04 * cv2.arcLength(cnt, True), True)\n",
    "    num_sides = len(poly_approx)\n",
    "\n",
    "    if num_sides == 3:\n",
    "        tri_contours.append(cnt)\n",
    "    elif num_sides == 4:\n",
    "        rect_contours.append(cnt)\n",
    "    elif num_sides >= 8:\n",
    "        primary_shape = \"circle\"\n",
    "    elif num_sides == 5:\n",
    "        is_direction_guide = True\n",
    "        break  \n",
    "\n",
    "# Decision logic \n",
    "if is_direction_guide:\n",
    "    print(\"Sign type: Direction guide\")  \n",
    "elif primary_shape == \"circle\" and red_coverage > 0.10:\n",
    "    print(\"Sign type: Prohibitory\")  \n",
    "elif tri_contours and red_coverage > 0.05:\n",
    "    print(\"Sign type: Warning\")  \n",
    "elif rect_contours and blue_coverage > 0.05:\n",
    "    print(\"Sign type: Informational\")  \n",
    "else:\n",
    "    print(\"Sign type: Unknown\")  "
   ]
